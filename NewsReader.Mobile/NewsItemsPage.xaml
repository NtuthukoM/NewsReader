<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NewsReader.Mobile.CustomControls"
             x:Class="NewsReader.Mobile.NewsItemsPage"
             Title="NewsItemsPage">
    <ScrollView>
        <ListView x:Name="NewsItemsListView"
                  RowHeight="230"
                      ItemTapped="NewsItemsListView_ItemTapped">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                        <controls:CardView BorderColor="DarkGray"
                                           Padding="5"
                              CardTitle="{Binding title}"
                              CardDescription="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla elit dolor, convallis non interdum."
                              IconBackgroundColor="SlateGray"
                              IconImageSource="{Binding thumbUrl}" />
                    </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
    </ScrollView>
</ContentPage>